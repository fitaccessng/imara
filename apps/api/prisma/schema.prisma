generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  EXPIRED
}

enum UserRole {
  USER
  ADMIN
}

enum UserAccountStatus {
  ACTIVE
  SUSPENDED
}

enum PlatformAdminRole {
  SUPER_ADMIN
  USER_MANAGEMENT_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  MARKETING_ADMIN
  OPERATIONS_ADMIN
  SECURITY_ADMIN
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED
}

enum PlatformAnnouncementAudience {
  ALL
  FREE
  PRO
  BUSINESS
}

enum PlatformAnnouncementEmailStatus {
  NOT_REQUESTED
  PENDING
  SENDING
  SENT
  FAILED
}

enum StoredFileUploadSource {
  STANDARD
  SCAN
  EVENT_MEDIA
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketCategory {
  ACCOUNT
  BILLING
  FILES
  EVENTS
  OTHER
}

enum StoredFileStatus {
  UPLOADING
  READY
  DELETING
}

enum FileCategory {
  FINANCE
  CONTRACTS
  HUMAN_RESOURCES
  OPERATIONS
  PERSONAL
  OTHER
}

enum EventGallerySetting {
  PRIVATE
  LINK_PUBLIC
  PASSCODE
}

enum EventStatus {
  ACTIVE
  DELETING
}

enum ApprovalReviewMode {
  SEQUENTIAL
  PARALLEL
}

enum ApprovalRequestStatus {
  IN_PROGRESS
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ReminderRecurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum ReminderDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum WorkspaceMemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum WorkspaceChatConversationType {
  WORKSPACE
  DIRECT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum SignatureRequestStatus {
  PENDING
  FINALIZING
  COMPLETED
  DECLINED
  CANCELLED
}

enum SignatureSignerStatus {
  PENDING
  SIGNED
  DECLINED
}

enum SignatureMethod {
  TYPED
  DRAWN
}

enum FolderPermissionEffect {
  GRANT
  RESTRICT
}

model User {
  id              String                @id @default(uuid()) @db.Uuid
  email           String                @unique @db.VarChar(320)
  passwordHash    String                @db.VarChar(255)
  name            String                @db.VarChar(120)
  role            UserRole              @default(USER)
  accountStatus   UserAccountStatus     @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  sessions        Session[]
  verificationTokens VerificationToken[]
  resetTokens     PasswordResetToken[]
  subscription    Subscription?
  folders         Folder[]
  files           StoredFile[]
  ownedWorkspaces Workspace[]           @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  sentInvitations WorkspaceInvitation[] @relation("InvitationInviter")
  auditEvents     AuditLog[]             @relation("AuditActor")
  platformAdminProfile PlatformAdminProfile?
  platformAdminAuditEvents PlatformAdminAuditLog[] @relation("PlatformAdminAuditActor")
  createdPlatformAnnouncements PlatformAnnouncement[] @relation("PlatformAnnouncementCreator")
  platformAnnouncementDeliveries PlatformAnnouncementDelivery[]
  supportTickets SupportTicket[] @relation("SupportTicketCustomer")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignee")
  supportMessages SupportTicketMessage[] @relation("SupportTicketMessageAuthor")
  notifications   Notification[]
  events          Event[]
  galleryGrants   EventGalleryGrant[]
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequester")
  approvalActivities ApprovalActivity[] @relation("ApprovalActivityActor")
  signatureRequests SignatureRequest[] @relation("SignatureRequestCreator")
  createdReminders Reminder[] @relation("ReminderCreator")
  assignedReminders Reminder[] @relation("ReminderAssignee")
  paymentAttempts PaymentAttempt[]
}

model PlatformAdminProfile {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @unique @db.Uuid
  role      PlatformAdminRole
  status    PlatformAdminStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role, status])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent String?  @db.VarChar(512)
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model VerificationToken {
  id            String   @id @default(uuid()) @db.Uuid
  tokenHash     String   @unique @db.Char(64)
  userId        String   @db.Uuid
  expiresAt     DateTime
  failedAttempts Int     @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id            String   @id @default(uuid()) @db.Uuid
  tokenHash     String   @unique @db.Char(64)
  userId        String   @db.Uuid
  expiresAt     DateTime
  failedAttempts Int     @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  plan              Plan     @default(FREE)
  storageLimitBytes BigInt   @default(5368709120)
  storageUsedBytes  BigInt   @default(0)
  storageReservedBytes BigInt @default(0)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentAttempt {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  plan        Plan
  amountMinor BigInt
  currency    String               @db.Char(3)
  checkoutId  String?              @unique @db.VarChar(128)
  status      PaymentAttemptStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  paidAt      DateTime?
  periodEnd   DateTime?
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PlanCatalogue {
  plan                       Plan     @id
  staffLimit                 Int
  activeEventLimit           Int
  storageLimitBytes          BigInt
  canEditDocuments           Boolean
  canScanDocuments           Boolean
  advancedTeamManagement     Boolean
  monthlyPriceMinor          BigInt
  currency                   String   @default("NGN") @db.Char(3)
  updatedAt                  DateTime @updatedAt
}

model Folder {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  parentFolderId  String?      @db.Uuid
  name            String       @db.VarChar(120)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent          Folder?      @relation("FolderTree", fields: [parentFolderId], references: [id], onDelete: Restrict)
  children        Folder[]     @relation("FolderTree")
  files           StoredFile[]
  events          Event[]
  workspaceId     String?      @db.Uuid
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions     FolderPermission[]

  @@index([userId, parentFolderId])
  @@index([userId, parentFolderId, name])
  @@index([workspaceId, parentFolderId])
  @@unique([workspaceId, id])
}

model StoredFile {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  folderId       String?         @db.Uuid
  objectKey      String          @unique @db.VarChar(512)
  originalName   String          @db.VarChar(255)
  mimeType       String          @db.VarChar(255)
  sizeBytes      BigInt
  status         StoredFileStatus @default(UPLOADING)
  uploadSource   StoredFileUploadSource @default(STANDARD)
  quotaReserved  Boolean          @default(true)
  isFavorite     Boolean          @default(false)
  contentHash    String?          @db.Char(64)
  category       FileCategory     @default(OTHER)
  tags           String[]         @default([])
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder         Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  workspaceId    String?          @db.Uuid
  workspace      Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventId         String?           @db.Uuid
  event           Event?            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  approvalAttachments ApprovalAttachment[]
  signatureSourceRequests SignatureRequest[] @relation("SignatureSourceFile")
  signatureFinalRequest SignatureRequest? @relation("SignatureFinalFile")
  chatMessages WorkspaceChatMessage[]

  @@index([userId, folderId, status, createdAt])
  @@index([userId, workspaceId, isFavorite, deletedAt, createdAt])
  @@index([userId, workspaceId, deletedAt, createdAt])
  @@index([workspaceId, folderId, status, createdAt])
  @@index([userId, workspaceId, contentHash, status])
  @@index([eventId, status, createdAt])
  @@unique([workspaceId, id])
}

model Event {
  id                 String              @id @default(uuid()) @db.Uuid
  ownerUserId        String              @db.Uuid
  folderId           String              @db.Uuid
  name               String              @db.VarChar(160)
  date               DateTime
  description        String?             @db.VarChar(4000)
  captureTokenHash   String              @unique @db.Char(64)
  galleryTokenHash   String              @unique @db.Char(64)
  gallerySetting     EventGallerySetting @default(PRIVATE)
  galleryPasscodeHash String?            @db.VarChar(255)
  storageCapBytes    BigInt
  storageUsedBytes   BigInt              @default(0)
  storageReservedBytes BigInt            @default(0)
  status             EventStatus         @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  owner              User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  folder             Folder              @relation(fields: [folderId], references: [id], onDelete: Restrict)
  files              StoredFile[]
  galleryGrants      EventGalleryGrant[]

  @@index([ownerUserId, date])
  @@index([gallerySetting, status])
}

model EventGalleryGrant {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  eventId   String   @db.Uuid
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, expiresAt])
  @@index([userId, expiresAt])
}

model Workspace {
  id          String                @id @default(uuid()) @db.Uuid
  name        String                @db.VarChar(160)
  ownerUserId String                @db.Uuid
  storageLimitBytes    BigInt        @default(5368709120)
  storageUsedBytes     BigInt        @default(0)
  storageReservedBytes BigInt        @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  owner       User                  @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  folders     Folder[]
  files       StoredFile[]
  auditLogs   AuditLog[]
  notifications Notification[]
  reminders Reminder[]
  approvalTemplates ApprovalTemplate[]
  approvalRequests ApprovalRequest[]
  signatureRequests SignatureRequest[]
  chatConversations WorkspaceChatConversation[]
  chatMessages WorkspaceChatMessage[]

  @@index([ownerUserId])
}

model SignatureRequest {
  id                 String                 @id @default(uuid()) @db.Uuid
  workspaceId        String                 @db.Uuid
  createdById        String                 @db.Uuid
  sourceFileId       String                 @db.Uuid
  sourceName         String                 @db.VarChar(255)
  sourceSnapshotKey  String                 @db.VarChar(512)
  sourceSha256       String                 @db.Char(64)
  mode               ApprovalReviewMode
  status             SignatureRequestStatus @default(PENDING)
  dueAt              DateTime?
  finalFileId        String?                @unique @db.Uuid
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  completedAt        DateTime?
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator            User                   @relation("SignatureRequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sourceFile         StoredFile             @relation("SignatureSourceFile", fields: [workspaceId, sourceFileId], references: [workspaceId, id], onDelete: Restrict)
  finalFile          StoredFile?            @relation("SignatureFinalFile", fields: [finalFileId], references: [id], onDelete: SetNull)
  signers            SignatureSigner[]

  @@index([workspaceId, status, createdAt])
  @@index([createdById, createdAt])
}

model SignatureSigner {
  id              String                @id @default(uuid()) @db.Uuid
  requestId       String                @db.Uuid
  memberId        String                @db.Uuid
  userId          String                @db.Uuid
  displayName     String                @db.VarChar(120)
  email           String                @db.VarChar(320)
  order           Int
  status          SignatureSignerStatus @default(PENDING)
  method          SignatureMethod?
  signedName      String?               @db.VarChar(120)
  signaturePng    String?               @db.Text
  signedAt        DateTime?
  consentText     String?               @db.VarChar(500)
  consentedAt     DateTime?
  consentedEmail  String?               @db.VarChar(320)
  consentIp       String?               @db.VarChar(64)
  declineReason   String?               @db.VarChar(1000)
  request         SignatureRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  deadlineReminder Reminder?

  @@unique([requestId, memberId])
  @@index([userId, status])
  @@index([requestId, order])
}

model WorkspaceMember {
  id          String               @id @default(uuid()) @db.Uuid
  workspaceId String               @db.Uuid
  userId      String               @db.Uuid
  displayName String?              @db.VarChar(120)
  role        WorkspaceRole        @default(STAFF)
  status      WorkspaceMemberStatus @default(ACTIVE)
  joinedAt    DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions FolderPermission[]
  templateApprovals ApprovalTemplateApprover[]
  requestApprovals ApprovalRequestApprover[]

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
  @@index([userId, status])
}

model WorkspaceChatConversation {
  id              String                       @id @default(uuid()) @db.Uuid
  workspaceId     String                       @db.Uuid
  type            WorkspaceChatConversationType
  channelKey      String                       @db.VarChar(100)
  memberAId       String?                      @db.Uuid
  memberBId       String?                      @db.Uuid
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  workspace       Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages        WorkspaceChatMessage[]

  @@unique([workspaceId, channelKey])
  @@unique([workspaceId, id])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, memberAId])
  @@index([workspaceId, memberBId])
}

model WorkspaceChatMessage {
  id              String                    @id @default(uuid()) @db.Uuid
  workspaceId     String                    @db.Uuid
  conversationId  String                    @db.Uuid
  senderMemberId  String                    @db.Uuid
  senderName      String                    @db.VarChar(120)
  content         String                    @db.VarChar(4000)
  fileId          String?                   @db.Uuid
  createdAt       DateTime                  @default(now())
  workspace       Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation    WorkspaceChatConversation @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  file            StoredFile?               @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([workspaceId, conversationId, createdAt, id])
  @@index([senderMemberId, createdAt])
  @@index([fileId])
}

model WorkspaceInvitation {
  id            String          @id @default(uuid()) @db.Uuid
  workspaceId   String          @db.Uuid
  email         String          @db.VarChar(320)
  name          String?         @db.VarChar(120)
  role          WorkspaceRole   @default(STAFF)
  initialPermissions Json?
  status        InvitationStatus @default(PENDING)
  tokenHash     String          @unique @db.Char(64)
  invitedById   String          @db.Uuid
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy     User            @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, email])
  @@index([workspaceId, status, expiresAt])
}

model FolderPermission {
  id          String                @id @default(uuid()) @db.Uuid
  workspaceId String                @db.Uuid
  folderId    String                @db.Uuid
  memberId    String                @db.Uuid
  effect      FolderPermissionEffect @default(GRANT)
  permissionKeys String[]            @default([])
  inherit     Boolean               @default(false)
  createdById String                @db.Uuid
  updatedById String                @db.Uuid
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  folder      Folder                @relation(fields: [workspaceId, folderId], references: [workspaceId, id], onDelete: Cascade)
  member      WorkspaceMember       @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, folderId, memberId, effect])
  @@index([workspaceId, memberId])
  @@index([folderId, memberId])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  actorId     String?   @db.Uuid
  action      String    @db.VarChar(100)
  targetType  String    @db.VarChar(80)
  targetId    String?   @db.VarChar(120)
  metadata    Json?
  ipAddress   String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(512)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, actorId, createdAt])
}

model PlatformAdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @db.VarChar(80)
  resourceId   String?  @db.VarChar(120)
  metadata     Json?
  ipAddress    String?  @db.VarChar(64)
  userAgent    String?  @db.VarChar(512)
  createdAt    DateTime @default(now())
  actor        User?    @relation("PlatformAdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId])
}

model PlatformAnnouncement {
  id              String                       @id @default(uuid()) @db.Uuid
  title           String                       @db.VarChar(120)
  body            String                       @db.VarChar(5000)
  audience        PlatformAnnouncementAudience
  emailEnabled    Boolean                      @default(false)
  createdAt       DateTime                     @default(now())
  createdByUserId String                       @db.Uuid
  creator         User                         @relation("PlatformAnnouncementCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  deliveries      PlatformAnnouncementDelivery[]

  @@index([createdAt])
}

model PlatformAnnouncementDelivery {
  id             String                            @id @default(uuid()) @db.Uuid
  announcementId String                            @db.Uuid
  userId         String                            @db.Uuid
  inAppReadAt    DateTime?
  emailStatus    PlatformAnnouncementEmailStatus   @default(NOT_REQUESTED)
  emailAttempts  Int                               @default(0)
  emailSentAt    DateTime?
  emailLastError String?                           @db.VarChar(255)
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt
  announcement   PlatformAnnouncement              @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User                              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, inAppReadAt, createdAt])
  @@index([emailStatus, updatedAt])
}

model SupportTicket {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @db.Uuid
  assignedAdminId String?               @db.Uuid
  subject         String                @db.VarChar(160)
  category        SupportTicketCategory
  priority        SupportTicketPriority @default(NORMAL)
  status          SupportTicketStatus   @default(OPEN)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  customer        User                  @relation("SupportTicketCustomer", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin  User?                 @relation("SupportTicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages        SupportTicketMessage[]

  @@index([userId, createdAt])
  @@index([status, priority, updatedAt])
  @@index([assignedAdminId, status, updatedAt])
}

model SupportTicketMessage {
  id           String        @id @default(uuid()) @db.Uuid
  ticketId     String        @db.Uuid
  authorId     String        @db.Uuid
  body         String        @db.VarChar(5000)
  internalNote Boolean       @default(false)
  createdAt    DateTime      @default(now())
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User          @relation("SupportTicketMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, internalNote, createdAt])
  @@index([authorId, createdAt])
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  type        String    @db.VarChar(100)
  message     String    @db.VarChar(500)
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([workspaceId, createdAt])
}

model Reminder {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  createdById     String   @db.Uuid
  assignedToId    String   @db.Uuid
  title           String   @db.VarChar(200)
  description     String?  @db.VarChar(2000)
  dueAt           DateTime
  nextDueAt       DateTime?
  recurrence      ReminderRecurrence @default(ONCE)
  emailEnabled    Boolean  @default(false)
  approvalRequestId String? @unique @db.Uuid
  signatureSignerId String? @unique @db.Uuid
  completedAt     DateTime?
  lastCompletedAt DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator         User     @relation("ReminderCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee        User     @relation("ReminderAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  signatureSigner SignatureSigner? @relation(fields: [signatureSignerId], references: [id], onDelete: Cascade)
  deliveries      ReminderDelivery[]

  @@index([workspaceId, dueAt, completedAt])
  @@index([assignedToId, nextDueAt, completedAt])
  @@index([createdById, createdAt])
}

model ReminderDelivery {
  id              String   @id @default(uuid()) @db.Uuid
  reminderId      String   @db.Uuid
  scheduledFor    DateTime
  status          ReminderDeliveryStatus @default(PENDING)
  emailStatus     PlatformAnnouncementEmailStatus @default(NOT_REQUESTED)
  attempts        Int      @default(0)
  lastError       String?  @db.VarChar(255)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sentAt          DateTime?
  reminder        Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, scheduledFor])
  @@index([status, updatedAt])
}

model ApprovalTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String   @db.VarChar(160)
  description String?  @db.VarChar(2000)
  createdById String   @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps       ApprovalTemplateStep[]
  requests    ApprovalRequest[]

  @@index([workspaceId, isActive, createdAt])
}

model ApprovalTemplateStep {
  id         String            @id @default(uuid()) @db.Uuid
  templateId String            @db.Uuid
  stepOrder  Int
  mode       ApprovalReviewMode
  template   ApprovalTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  approvers  ApprovalTemplateApprover[]

  @@unique([templateId, stepOrder])
}

model ApprovalTemplateApprover {
  id       String               @id @default(uuid()) @db.Uuid
  stepId   String               @db.Uuid
  memberId String               @db.Uuid
  step     ApprovalTemplateStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  member   WorkspaceMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([stepId, memberId])
  @@index([memberId])
}

model ApprovalRequest {
  id              String                @id @default(uuid()) @db.Uuid
  workspaceId     String                @db.Uuid
  requesterId     String?               @db.Uuid
  templateId      String?               @db.Uuid
  title           String                @db.VarChar(200)
  description     String?               @db.VarChar(5000)
  status          ApprovalRequestStatus @default(IN_PROGRESS)
  currentStepOrder Int                  @default(0)
  dueAt           DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requester       User?                 @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  template        ApprovalTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  steps           ApprovalRequestStep[]
  activities      ApprovalActivity[]
  attachments     ApprovalAttachment[]
  deadlineReminder Reminder?

  @@index([workspaceId, status, createdAt])
  @@index([requesterId, status, createdAt])
  @@index([workspaceId, dueAt, status])
}

model ApprovalRequestStep {
  id        String                @id @default(uuid()) @db.Uuid
  requestId String                @db.Uuid
  stepOrder Int
  mode      ApprovalReviewMode
  isComplete Boolean             @default(false)
  request   ApprovalRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approvers ApprovalRequestApprover[]

  @@unique([requestId, stepOrder])
}

model ApprovalRequestApprover {
  id          String          @id @default(uuid()) @db.Uuid
  stepId      String          @db.Uuid
  memberId    String          @db.Uuid
  decision    ApprovalDecision @default(PENDING)
  decidedAt   DateTime?
  step        ApprovalRequestStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  member      WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([stepId, memberId])
  @@index([memberId, decision])
}

model ApprovalActivity {
  id        String          @id @default(uuid()) @db.Uuid
  requestId String          @db.Uuid
  actorId   String?         @db.Uuid
  action    String          @db.VarChar(80)
  comment   String?         @db.VarChar(2000)
  createdAt DateTime        @default(now())
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     User?           @relation("ApprovalActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

model ApprovalAttachment {
  id        String          @id @default(uuid()) @db.Uuid
  requestId String          @db.Uuid
  fileId    String?         @db.Uuid
  fileName  String          @db.VarChar(255)
  createdAt DateTime        @default(now())
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  file      StoredFile?     @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([requestId, fileId])
  @@index([fileId])
}
