NODE_ENV=development
EMAIL_DELIVERY=smtp
PORT=3001
DATABASE_URL=postgresql://imara:local-development-only@localhost:5432/imara?schema=public
# Comma-separated exact browser origins (include scheme and port).
# Production example: https://www.useimara.space,https://useimara.space
CORS_ORIGINS=http://localhost:5173
# Production example: https://www.useimara.space (used for links in email).
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_NAME=imara_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=30
EMAIL_OTP_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=30
# Set OBJECT_STORAGE_DRIVER=local only for development/test. Local media lives
# under OBJECT_STORAGE_LOCAL_DIR and local storage is rejected in production.
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_LOCAL_DIR=.local-object-storage
# SMTP is used for email flows by default. For local testing only, set
# EMAIL_DELIVERY=console to auto-verify new accounts and print reset/invitation
# links in the API log. Console mode is ignored outside development/test.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
# Brevo SMTP login. Get the SMTP key from Brevo (not your account password) and
# put it in the ignored apps/api/.env as SMTP_PASSWORD.
SMTP_USER=a5fe00001@smtp-brevo.com
SMTP_PASSWORD=
# Use a sender address verified with your SMTP provider.
SMTP_FROM="IMARA <noreply@useimara.space>"
# DockHive Hive Buckets (S3-compatible). Obtain endpoint, bucket, and keys from your
# DockHive account; never commit production credentials. Leave unset to disable uploads.
DOCKHIVE_S3_ENDPOINT=https://s3-us.dockhive.io
DOCKHIVE_S3_REGION=auto
DOCKHIVE_BUCKET=imara
DOCKHIVE_ACCESS_KEY_ID=
DOCKHIVE_SECRET_ACCESS_KEY=
# true uses the widely supported endpoint/bucket/key S3 request style.
DOCKHIVE_S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=26214400
